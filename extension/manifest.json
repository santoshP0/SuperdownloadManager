{
  "manifest_version": 3,
  "name": "Super Download Manager",
  "short_name": "SDM",
  "version": "1.0.0",
  "description": "Send downloads to Super Download Manager for faster parallel downloading. One click — that's it.",
  "permissions": [
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:9876/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Super Download Manager"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sdm@superdownloadmanager.app",
      "strict_min_version": "109.0"
    }
  }
}
